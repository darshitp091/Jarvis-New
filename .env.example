# ============================================================
#  Jarvis configuration  --  copy this file to ".env"
#  Then fill in your real values. NEVER commit .env.
# ============================================================

# ---- Identity ----
# Your (first) name — Jarvis will address you by this.
JARVIS_USER_NAME=Darshit

# ---- LLM provider (OpenAI-compatible) ----
JARVIS_LLM_BASE_URL=https://100milionseek.top/v1
JARVIS_LLM_API_KEY=PASTE_YOUR_KEY_HERE
# Or pin one after you see the list, e.g. JARVIS_LLM_MODEL=some-model-id
JARVIS_LLM_MODEL=deepseek-v4.1-flash-free

# ---- Voice ----
# Hindi/Hinglish male or female voice.
#   hi-IN-MadhurNeural  (male)
#   hi-IN-SwaraNeural   (female)
JARVIS_TTS_VOICE=hi-IN-MadhurNeural
JARVIS_STT_MODEL=tiny              # tiny | base | small  (tiny = lowest RAM)
JARVIS_STT_COMPUTE=int8

# ---- Wake word ----
JARVIS_WAKE_WORD=hey jarvis

# ---- Feature flags (0 = off, 1 = on) ----
JARVIS_ENABLE_CAMERA=0
JARVIS_ENABLE_SCREEN_WATCH=0
JARVIS_ENABLE_SPOTIFY_UI=1
JARVIS_ENABLE_ETHICAL_SECURITY=1

# ---- Safety ----
# When 0 (recommended) Jarvis asks before destructive actions.
JARVIS_AUTO_APPROVE=0

# ---- Paths (optional overrides) ----
# JARVIS_DATA_DIR=C:\Users\patel\jarvis\data
# JARVIS_VAULT_DIR=C:\Users\patel\jarvis\vault   # open this folder in Obsidian
